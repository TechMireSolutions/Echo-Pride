# Server
PORT=5005
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Auth secrets — change these before going live
JWT_SECRET=change-me-echopride-access-secret
JWT_REFRESH_SECRET=change-me-echopride-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=ep_refresh

# Default admin account (created on first boot)
ADMIN_EMAIL=admin@echopride.com
ADMIN_PASSWORD=admin110

# Storage
DB_PATH=./data/echopride.db
UPLOAD_DIR=./uploads
